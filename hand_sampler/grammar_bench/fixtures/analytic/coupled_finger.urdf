<?xml version="1.0"?>
<robot name="coupled_finger">
  <link name="base"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>

  <!-- joint1: independent -->
  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- joint2: mimics joint1 with offset != 0; own limits exactly match the image (no conflict) -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.03 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.4" upper="1.6" effort="1.0" velocity="1.0"/>
    <mimic joint="joint1" multiplier="1.5" offset="0.1"/>
  </joint>

  <!-- joint3: mimics joint1 with negative multiplier; own limits deliberately tighter than
       the image (-1.0, 1.0) -> LimitConflict with excess = 0.5 + 0.2 = 0.7 -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.03 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.8" effort="1.0" velocity="1.0"/>
    <mimic joint="joint1" multiplier="-1.0" offset="0.0"/>
  </joint>
</robot>
