# venvs / caches
.venv*/
__pycache__/
*.py[cod]
*.egg-info/
.cache/
.ruff_cache/
.pytest_cache/

# run outputs
outputs/
train_dir/
results/
wandb/
videos/
viser_viz_data/
*.log

# large generated assets
**/generated_urdfs/

# Claude Code local state (contains credentials) — never commit
.claude/

# Large binaries kept on disk but out of git. Both are copied verbatim from
# /share/portal/kk837/simtoolreal (.gitignore has no inline comments, so the
# annotations live here):
#   pretrained_policy/        395 MB SHARPA SAPG checkpoint - the M1 parity anchor
#   assets/dextoolbench/data/ 484 MB real tool scans + collision decompositions
pretrained_policy/
assets/dextoolbench/data/

# rl_games fork docs/notebooks: ~37 MB of gifs and ipynbs, none of it used here
third_party/rl_games/docs/
third_party/rl_games/notebooks/

# benchmark outputs (multi-GB logs; results are summarised in docs)
bench_dir/

# Sampled hand URDFs are REGENERABLE from the population manifest, which stores
# every parameter vector. Committing ~100 near-identical generated files per
# population would bury real diffs. gen_sharpa_like.urdf is NOT ignored: it is a
# hand-checked reference that training runs and the wandb pose viewer fetch by
# URL, so it must exist in the repo.
assets/urdf/generated/gen_[0-9]*.urdf
assets/urdf/generated/population/**/*.urdf
assets/urdf/generated/mut_*.urdf
assets/urdf/generated/loop_*.urdf
assets/urdf/generated/_*preview*.urdf
# Mutant and loop-generation hands, and the viewers' preview files. Same rule as
# the sampled URDFs above -- every one is regenerable from its manifest's
# parameter vector -- but the scale is different: one mutation pass over a 24,576
# population writes 122,880 files, which would bury every real diff in the repo.
# The viewers write their preview HERE rather than /tmp on purpose: build_hand_urdf
# emits arm mesh references as ../kuka_sharpa_description/, which resolves only
# from this directory, and a preview written elsewhere renders an arm with no
# meshes and no colliders (docs/multi_embodiment.md 4).

# ...and the manifests themselves. A 24,576-hand manifest is 266 MB of JSON and
# each of its 10 shards is another 25 MB; `git add -A` swept 509 MB into a
# commit. They are REGENERABLE: seed + gate + shard count + the code at that
# revision reproduce the population, which is why the manifest records all
# three. Rebuild with 00_build_population_sharded.sub rather than cloning them.
assets/urdf/generated/population/**/manifest.json
assets/urdf/generated/population/**/shard_*.json

# Reconstructed run->object assignments. Regenerate with
# `python -m genmech.eval.embodiments.dump_assignment --run_dir ...`;
# multi-MB and derived entirely from a run's config, so not worth versioning.
genmech/eval/embodiments/assignments/*.json
