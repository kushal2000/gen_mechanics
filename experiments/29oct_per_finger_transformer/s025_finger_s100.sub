#!/bin/bash
#SBATCH --job-name=PF_s025_finger_s100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29oct_per_finger_transformer/%x-%j.log
# coarse_s0_025 (13 hand joints), the per-finger transformer, next to 29oct_mlp_vs_transformer's MLP (782703) and per-joint transformer (782705) on the same hand, env and seed.
# The per-finger transformer (experiments/29oct_transformer_speed/README.md's pick, the OlympicsJointTransformerSAPG.yaml
# default since 29 Oct), every setting written out: one token per finger (its up-to-5 joint tokens palm -> tip + 5
# validity bits), width 128, 2 layers, 4 heads, ff x4, shared decoder MLP [256] -> 5 actions per finger, the palm-cut
# joint's action from the wrist head, default wrist [1024,512] / value [512,256] heads, no affine LayerNorm, the whole
# net compiled, fp16 rollouts (rollout_autocast); the 14 Oct learner unchanged (minibatch 16384, 2 mini-epochs,
# lr 1e-4 adaptive); ghost slots and the locked wrist rotation masked. Env as experiments/29oct_mlp_vs_transformer:
# pen repose v2, finger_target=home, action delay OFF, the pre-27-Oct tokens, seed 100.
#   sbatch experiments/29oct_per_finger_transformer/s025_finger_s100.sub
set -euo pipefail
cd /share/portal/kk837/gen_mechanics
export HAND=assets/urdf/27oct_grammar_random_hands/coarse_s0_025/coarse_s0_025.spec.json
export HAND_TAG=s025
export TASKS=pen_repose
export PEN_SHAPE=box
export ARCH=transformer
export NUM_ENVS=24576 EPOCHS=5000 SEED=100 GAMMA=0.99
export FINGER_RESET=1.0 KEYPOINT=best_so_far
export EXTRA_HYDRA="env.goal.first_goal_tolerance=0.03 env.pen_repose.random_first_goal=True env.pen_repose.goal_sampling=uniform env.action.wrist_max_speed_ang=0.0 env.action.finger_target=home env.action.use_action_delay=False env.obs.obs_list=[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot] env.obs.state_list=[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot,object_keypoints_rel_joint,palm_keypoints,ee_pos,ee_rot,ee_vel,object_rot,fingertip_pos_rel_palm,closest_keypoint_max_dist,closest_fingertip_dist,progress,successes,reward] agent.params.network.token_mode=finger agent.params.network.d_model=128 agent.params.network.n_layers=2 agent.params.network.n_heads=4 agent.params.network.ff_mult=4 agent.params.network.decoder_units=[256] agent.params.network.arm_head_units=[1024,512] agent.params.network.value_head_units=[512,256] agent.params.network.compile_net=true agent.params.network.affine_norm=false agent.params.network.mask_ghost_actions=true agent.params.network.masked_arm_dims=[3,4,5] agent.params.config.rollout_autocast=true agent.params.config.minibatch_size=16384 agent.params.config.mini_epochs=2 agent.params.config.learning_rate=1e-4"
export RUN_TAG=finger_home
export LOG_GROUP=29oct_per_finger_transformer
export WANDB_PROJECT=gen_mechanics_mlp_vs_jt WANDB=1
exec bash experiments/12oct_inhand_olympics/olympics_sapg_mlp.sub
