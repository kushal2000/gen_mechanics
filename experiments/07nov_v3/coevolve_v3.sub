#!/bin/bash
#SBATCH --job-name=CO2_run
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=96000
#SBATCH --time=12:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/coevolve/%x-%j.log
# v3 (7 Nov): link-only hands, v3 MAP-Elites cells and operators (experiments/07nov_v3/coevolve_v3.py); otherwise as the
# v2 chain (experiments/06nov_coevolve_v2/coevolve.sub): SAPG exploration scale from config.json; the campaign log-std
# cap from debug_outputs/coevolve/v3/TRAIN_PINS.json. No 100-env evals (training-log labels only).
# One iteration of a co-evolution run (coevolve.py): train the run's current archive for 1B steps (2,604 epochs,
# 24,576 envs, the settled learner, per-episode logs on, the fixed reset), submit its 100-env eval (async), fork the
# campaign's runs after gen 0 (forks.json, once), propose the next archive (K rounds; K 0 = House of Dextra), resubmit.
#   sbatch --job-name=CO3_<name> --export=ALL,RUN=debug_outputs/coevolve/v3/<name> experiments/07nov_v3/coevolve_v3.sub
#   [MAX_GEN=49]
set -euo pipefail
cd /share/portal/kk837/gen_mechanics
P=.venv_isaacsim/bin/python
C=experiments/07nov_v3/coevolve_v3.py
SUB=experiments/07nov_v3/coevolve_v3.sub
NAME=$(basename "$RUN")
CAMPDIR=$(dirname "$RUN")
CAMP=$(basename "$CAMPDIR")
read -r G TRAINED CKPT < <($P -c "import json; s = json.load(open('$RUN/state.json')); print(s['generation'], int(s['trained']), s['checkpoint'] or '-')")
GD=$RUN/$(printf gen_%04d "$G")
echo "[coevolve] $NAME gen $G on $(hostname) (trained $TRAINED, from ${CKPT})"

if [ "$TRAINED" = 0 ]; then
  OBS="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_origin,joint_axis,joint_link_vec,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot]"
  STATE="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_origin,joint_axis,joint_link_vec,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot,object_keypoints_rel_joint,palm_keypoints,ee_pos,ee_rot,ee_vel,object_rot,fingertip_pos_rel_palm,closest_keypoint_max_dist,closest_fingertip_dist,progress,successes,reward]"
  ENV="env.goal.first_goal_tolerance=0.03 env.pen_repose.random_first_goal=True env.pen_repose.goal_sampling=uniform env.action.wrist_max_speed_ang=0.0 env.action.finger_target=home env.action.use_action_delay=False env.reset.table_safe=True env.obs.obs_list=$OBS env.obs.state_list=$STATE env.log.group_stats=True env.log.design_stats=True"
  NET="agent.params.network.token_mode=finger agent.params.network.d_model=128 agent.params.network.n_layers=2 agent.params.network.n_heads=4 agent.params.network.ff_mult=4 agent.params.network.decoder_units=[256] agent.params.network.arm_head_units=[1024,512] agent.params.network.value_head_units=[512,256] agent.params.network.compile_net=true agent.params.network.affine_norm=false agent.params.network.packed_tokens=true agent.params.network.mask_ghost_actions=true agent.params.network.masked_arm_dims=[3,4,5]"
  SCALE=$($P -c "import json; print(json.load(open('$RUN/config.json')).get('expl_reward_coef_scale', 0.002))")
  echo "[coevolve] $NAME gen $G: SAPG exploration-bonus scale $SCALE"
  LEARN="agent.params.config.rollout_autocast=true agent.params.config.minibatch_size=16384 agent.params.config.mini_epochs=2 agent.params.config.expl_reward_coef_scale=$SCALE"
  LOG_GROUP="coevolve/$CAMP/$NAME/$(basename "$GD")"
  rm -rf "debug_outputs/train_logs/$LOG_GROUP"                    # a resubmitted iteration trains afresh
  CK_VARS=()
  [ "$CKPT" != "-" ] && CK_VARS=(CHECKPOINT="$CKPT" CHECKPOINT_MODE=weights)
  env TASKS=pen_repose PEN_SHAPE=box ARCH=transformer NUM_ENVS=24576 SEED="${SEED:-100}" GAMMA=0.99 FINGER_RESET=1.0 \
      KEYPOINT=best_so_far HAND="multi:template:$GD/manifest.json" HAND_TAG=evo RUN_TAG="${CAMP}_${NAME}_g$G" \
      LOG_GROUP="$LOG_GROUP" EPOCHS="${EPOCHS_PER_GEN:-2604}" EXTRA_HYDRA="$ENV $NET $LEARN" \
      WANDB="${WANDB:-1}" WANDB_PROJECT="${WANDB_PROJECT:-v3_coevolve}" WANDB_NAME="${CAMP}_${NAME}_iter_$G" \
      WANDB_GROUP="${CAMP}_${NAME}" VIEWER_INTERVAL="${VIEWER_INTERVAL:-20000}" VIEWER_LEN=600 \
      ${CK_VARS[@]+"${CK_VARS[@]}"} \
      bash experiments/oct_2026_experiments/12oct_inhand_olympics/olympics_sapg_mlp.sub > "$GD/train.log" 2>&1 || true
  grep -q "MAX EPOCHS" "$GD/train.log" || { echo "[coevolve] training did not finish; see $GD/train.log"; tail -20 "$GD/train.log"; exit 1; }
  TRAIN_RUN=$(ls -d "debug_outputs/train_logs/$LOG_GROUP"/*/ | head -1)
  NEW=$(ls -t "$TRAIN_RUN"*/nn/last_*_ep_*.pth | head -1)
  cp "$NEW" "$GD/policy.pth"
  $P $C trained --run "$RUN" --train-run "$TRAIN_RUN" --checkpoint "$GD/policy.pth"
  # (no evals in v3: labels from the training logs)
fi

$P $C next --run "$RUN"
if (( G + 1 < ${MAX_GEN:-49} )); then
  sbatch --job-name="CO3_$NAME" --export=ALL,RUN="$RUN" "$SUB"
else
  echo "[coevolve] $NAME: reached MAX_GEN=${MAX_GEN:-49}"
fi
