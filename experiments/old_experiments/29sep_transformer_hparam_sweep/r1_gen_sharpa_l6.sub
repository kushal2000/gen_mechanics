#!/bin/bash
#SBATCH --job-name=sw1_l6
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --signal=B:USR1@900
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29sep_transformer_hparam_sweep/r1_l6-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29sep_transformer_hparam_sweep/r1_l6-%j.err

# TRANSFORMER SWEEP, round 1, variant "l6" on gen_sharpa. Generated by make_sweep.py -- edit
# that, not this. Differs from the sweep BASE only in: TRANSFORMER_LAYERS=6
export ARCH=transformer
export OBS_LIST="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel]"
export USER_HYDRA="agent.params.config.gamma=0.998"
export LEARNING_RATE=0.0005
export MINI_EPOCHS=5
export D_MODEL=64
export TRANSFORMER_LAYERS=6
export N_HEADS=1
export FF_MULT=2
export MU_HEAD_UNITS="[64]"
export VALUE_HEAD_UNITS="[512,256]"
export HORIZON=16
export LR_SCHEDULE=adaptive
set -euo pipefail
export ROBOT_SPEC="${ROBOT_SPEC:-handonly:/share/portal/kk837/gen_mechanics/assets/populations/sharpa_capsule.json}"
export STUDY_ID="${STUDY_ID:-sw1_gen_sharpa_l6}"
export SUCCESS_TOLERANCE_DEG=5
# 2000-epoch budget per run, no chained continuation.
export EPOCHS="${EPOCHS:-2000}" MAX_CONT="${MAX_CONT:-1}" CONT="${CONT:-1}"
export WANDB_PROJECT="${WANDB_PROJECT:-gen_mechanics_gen_sharpa_tf_sweep}"
export SCALING_RUN_ROOT="${SCALING_RUN_ROOT:-/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29sep_transformer_hparam_sweep}"

source /share/portal/kk837/gen_mechanics/experiments/old_experiments/28sep_inhand_reorientation/common.sh
run_and_chain "$0"
