#!/bin/bash
#SBATCH --job-name=gsharpa_eval
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=128000
#SBATCH --time=02:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/gen_sharpa_eval/eval-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/gen_sharpa_eval/eval-%j.err

# ZERO-SHOT: would gen-SHARPA have survived this generation's cut?
#
# ONE RANK OF THE OBJECT DEAL. design_cycle gives env e object
# (e // n_designs) % 24, so a single 12288-env process only reaches objects
# 0..11; training ran two ranks. Submit this twice, RANK=0 and RANK=1, and the
# reader merges the tables -- then every design has met all 24 objects, as it
# did when the generation ranked them.
#
# Generation k's policy scores generation k's population with gen-SHARPA swapped
# in, at the tolerance that generation ended on. Nothing trains and nothing
# adapts -- see eval_population.py on why this is not a training job with the
# learning rate zeroed. One GPU: 1024 designs over 12288 envs is 12 envs each,
# and the evaluation only has to rank them.
#
#   sbatch --export=ALL,META=<...meta.json> gen_sharpa_eval.sub
set -euo pipefail
: "${META:?path to a prep_gen_sharpa_eval meta.json}"
cd /share/portal/kk837/gen_mechanics
mkdir -p debug_outputs/train_logs/gen_sharpa_eval
source .venv_isaacsim/bin/activate
export OMNI_KIT_CACHE_PATH="${SLURM_TMPDIR:-/tmp}/${USER}_gsharpa_${SLURM_JOB_ID:-local}"
mkdir -p "$OMNI_KIT_CACHE_PATH"
python -u experiments/old_experiments/17sep_coevolution/analysis/eval_population.py --headless \
    --meta "$META" --steps "${STEPS:-14400}" --rank "${RANK:-0}" --world_size 2 ${DETERMINISTIC:+--deterministic} \
    env.scene.num_envs="${NUM_ENVS:-12288}" \
    'env.obs.obs_list=${env.obs.state_list}' \
    `# the objects the policy trained on. These live in common.sh and reach the` \
    `# trainer through run_rank.sh; this script calls the env directly, so without` \
    `# them it silently falls back to the dataclass defaults -- the random 1200` \
    `# pool with env_modulo, a different task from the one being evaluated.` \
    env.assets.object_pool="${OBJECT_POOL:-diverse24}" \
    env.assets.object_assignment="${OBJECT_ASSIGNMENT:-design_cycle}" \
    env.action.arm_moving_average=1.0 env.action.hand_moving_average=1.0 \
    env.domain_randomization.use_obs_delay=false env.domain_randomization.use_action_delay=false \
    env.domain_randomization.use_object_state_delay_noise=false \
    env.domain_randomization.joint_velocity_obs_noise_std=0.0 \
    env.domain_randomization.force_scale=0.0 env.domain_randomization.torque_scale=0.0
