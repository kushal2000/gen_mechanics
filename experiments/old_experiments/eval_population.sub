#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --get-user-env
#SBATCH --mem=96000
# 8 CPUs / 96 GB, down from 12 / 200 GB. MEMORY was what capped concurrency, not
# CPUs: job 712165 peaked at 32.7 GB against a 200 GB request, and 200 GB against
# a 1,547 GB node allowed only 7 evals where the 8 GPUs would allow 8. Nodes 03/04
# sit on 304 idle cores, so CPUs were never the constraint.
#
# Cutting to 1 CPU was tried and measured: scene build 476 s -> 598 s and boot
# 733 s -> 916 s, +26%, for no gain in how many fit per node. 8 recovers that
# while staying irrelevant to packing.
#SBATCH -t 12:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

# Score EVERY embodiment in a population on the object it trained against.
#
#   RUN_DIR=train_dir/gen_mechanics/multi_embodiment_control/mec_population24k_seed0_2026-08-17_15-13-28 \
#   CKPT=$RUN_DIR/0_pose_reach_sapg/nn/0_pose_reach_sapg.pth \
#   EPISODES=10 \
#   sbatch experiments/old_experiments/eval_population.sub
#
# One Kit boot holds all 24,576 designs at once -- env i is design i with object
# i % 1200, the training pairing exactly. That is why this is a single job and
# not an array: splitting it would cost one ~6 min scene build per shard and
# gain nothing, since diversity is free per step (docs/multi_embodiment.md §2).
#
# Budget: ~6 min setup, then up to 300 * goals * episodes steps at roughly 8
# steps/s at 24,576 envs -- about an hour at the defaults, less because most
# envs terminate before the per-episode cap.
#
# NOTE the checkpoint path includes the RUN NAME twice: <run>/0_pose_reach_sapg/nn/.
# Pointing at <run>/nn/ silently ran a RANDOM policy before rl_player.py grew a
# guard, because rl_games' restore is `if os.path.exists(fn)`.

set -euo pipefail

REPO_ROOT="/share/portal/kk837/gen_mechanics"
RUN_DIR="${RUN_DIR:?set RUN_DIR to a population training run directory}"
CKPT="${CKPT:?set CKPT to a checkpoint .pth}"
EPISODES="${EPISODES:-10}"
# THROUGHPUT MODE. When set, the run is a fixed step budget and each design is
# scored by the TOTAL goals it hits inside it, over however many episodes it
# gets. Every design receives the same budget -- nothing is frozen out early --
# so the number is a rate, and a design that drops the object is charged for the
# time it wastes rather than being handed a fresh episode for free.
#
# 6000 steps is ~10 per-goal timeouts (episode_length is 600 policy steps, and
# termination_utils zeroes episode_length_buf on every goal hit, so 600 is a
# per-GOAL clock, not a per-episode one).
STEP_BUDGET="${STEP_BUDGET:-0}"
# Sets termination.max_consecutive_successes -- the goal count that ENDS an
# episode. In throughput mode this should be high enough that it rarely fires,
# or the best designs are forced through a reset they are then charged for.
# Training used 50 and averaged 7.1, so 50 costs almost nothing here.
GOALS="${GOALS:-10}"
DR="${DR:-off}"
# A committed EvalCondition id from genmech/eval/suites.py, e.g.
# "dr_knob/object_friction". Applied ON TOP of DR, so it wins on every field it
# names. The dr_knob conditions pin every DR field explicitly -- pass DR=off
# with them so the baseline underneath is the population runs' own setting.
CONDITION="${CONDITION:-}"
# Score a DIFFERENT population under this run's policy: a directory holding
# manifest.json. Mutant populations are index-aligned to their parents, so child
# i lands in env i with object i % pool_size -- the same object parent i held.
POPULATION_PATH="${POPULATION_PATH:-}"
# Pins the ROLLOUT rng (object spawn tumble, goal sequences). Two runs differing
# only in this are independent replicates of one measurement.
ENV_SEED="${ENV_SEED:-}"
# Cumulative goals recorded every N steps, so one run measures every budget up
# to STEP_BUDGET at once.
SNAPSHOT_EVERY="${SNAPSHOT_EVERY:-0}"
# Record the critic's mean V(s) per design alongside goals. Free -- the action
# forward pass already computes it.
RECORD_VALUE="${RECORD_VALUE:-0}"
# Metres. The suite default (0.01) is the curriculum FLOOR -- the tightest bar
# training ever sets. A mid-training checkpoint has usually not tightened that
# far, so scoring it there collapses most designs to zero and leaves the
# ranking with no resolution. Set this to match where the run actually is.
SUCCESS_TOLERANCE="${SUCCESS_TOLERANCE:-}"
SAPG_EXPL_COEF="${SAPG_EXPL_COEF:-50.0}"
TAG="${TAG:-$(date +%Y-%m-%d_%H-%M-%S)}"
OUT_DIR="${OUT_DIR:-${REPO_ROOT}/results/population_eval/$(basename "$RUN_DIR")_${TAG}}"

cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export OMNI_KIT_ACCEPT_EULA=YES
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache_popeval"
mkdir -p "$OMNI_KIT_CACHE_PATH" "$OUT_DIR"

[ -n "${SLURM_JOB_ID:-}" ] && scontrol update JobId="$SLURM_JOB_ID" \
    JobName="popeval_$(basename "$RUN_DIR")" || true
exec > "${OUT_DIR}/eval.log" 2> "${OUT_DIR}/eval.err"

echo "run_dir=$RUN_DIR"
echo "ckpt=$CKPT"
echo "condition=${CONDITION:-none}"
echo "episodes=$EPISODES goals=$GOALS dr=$DR tol=${SUCCESS_TOLERANCE:-suite-default} step_budget=$STEP_BUDGET out=$OUT_DIR"
ls -la "$CKPT"

python -u -m genmech.eval.embodiments.run_population_eval \
    --run_dir "$RUN_DIR" \
    --checkpoint "$CKPT" \
    --episodes "$EPISODES" \
    --goals_per_episode "$GOALS" \
    --dr "$DR" \
    ${CONDITION:+--condition "$CONDITION"} \
    ${POPULATION_PATH:+--population_path "$POPULATION_PATH"} \
    ${ENV_SEED:+--env_seed "$ENV_SEED"} \
    $( [ "$SNAPSHOT_EVERY" -gt 0 ] && echo "--snapshot_every $SNAPSHOT_EVERY" ) \
    $( [ "$RECORD_VALUE" -gt 0 ] && echo "--record_value" ) \
    --sapg_expl_coef "$SAPG_EXPL_COEF" \
    ${SUCCESS_TOLERANCE:+--success_tolerance "$SUCCESS_TOLERANCE"} \
    $( [ "$STEP_BUDGET" -gt 0 ] && echo "--step_budget $STEP_BUDGET" ) \
    --out "$OUT_DIR"
