#!/bin/bash
#SBATCH --job-name=isaaclab_ourhand
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ourhand-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ourhand-%j.err
#
# DELTA: OUR physical Allegro (the USD our env builds from our URDF) in their env, with our
# drive settings. Measured live: torque cap 0.35 vs their 0.50 N.m, fingertip links 0.021 vs
# ~0.10 kg, armature 0.001 vs 0, 2 mm contact offset. Palm placed at their measured palm_link
# pose, so the cube spawn relative to the palm is rung 0's: probe (102.4, 8.5, 57.3) mm, 99.6%
# held by a do-nothing hand at 10 s.
#
# ONE DELTA FROM THE REFERENCE, everything else theirs -- env, network and PPO. Read
# against isaaclab_reference.sub (590311), which at 8192 envs took episode length from
# 19 to 550 by epoch 142 and reached 0.207 goals/episode by epoch 1054. The comparison is
# at MATCHED EPOCHS, not matched wall-clock.
#
# The header of isaaclab_reference.sub carries the shared reasoning; this file only says
# what is different. See the rung's docstring in isaacsimenvs/inhand_isaaclab/env_cfg.py.
#
#   sbatch isaaclab_rung_ourhand.sub
set -euo pipefail
REPO=/share/portal/kk837/gen_mechanics
export OMNI_KIT_ACCEPT_EULA=YES
mkdir -p "$REPO/debug_outputs/train_logs/inhand_isaaclab"
cd "$REPO"
echo "[isaaclab_ourhand] task GenMech-InHandIsaacLab-ourhand-v0  extra: "
exec .venv_isaacsim/bin/python -u -m isaacsimenvs.inhand_isaaclab.train \
    --task "GenMech-InHandIsaacLab-ourhand-v0" --num-envs "${NUM_ENVS:-8192}" --max-epochs "${MAX_EPOCHS:-5000}" \
    --seed "${SEED:-42}"  --wandb
