#!/bin/bash
#SBATCH --job-name=isaaclab_ref
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ref-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ref-%j.err

# ISAACLAB'S IN-HAND REFERENCE, TRAINED AS-IS.
#
# The baseline our own task has never had: a formulation that is known to learn. Our
# in-hand task has not scored goals reliably, and without a reference that does there is
# no way to separate a broken environment from a hard one.
#
# The ENV is entirely IsaacLab's -- their ManagerBasedRLEnv, their AllegroCubeEnvCfg,
# their reward, observation and command terms, their Allegro USD from the Isaac cloud
# asset root. The LEARNER is ours: rl_games, with their shipped agent config translated
# into our SAPG fork's dialect (three translations, documented in train.py where each
# one bites). So this does NOT go through common.sh, run_rank.sh, a RobotSpec or the
# joint transformer -- none of which a manager-based env has.
#
# Reference values, verified in this install rather than read off a config: 16 joints,
# 21 bodies, 72-d observation, 16-d action, decimation 4, dt 1/120, episode 20 s,
# success threshold 0.1 rad = 5.73 deg, cube 60 mm, palm 5.40 deg off vertical.
#
# 8192 envs x horizon 24 = 196608, which their minibatch of 16384 divides 12 times -- so
# no minibatch is left a different width. train.py refuses to start if that stops being
# true rather than training on a ragged last batch.
#
#   sbatch isaaclab_reference.sub
#   sbatch --export=ALL,TASK=GenMech-InHandIsaacLab-step1-decimation-v0 isaaclab_reference.sub
#
# The ladder rungs -- step1 decimation 2, step2 episode 10 s, step3 threshold 20 deg --
# each change ONE thing toward our config with the learner held fixed, so whichever rung
# stops learning is the answer.
set -euo pipefail

REPO=/share/portal/kk837/gen_mechanics
export TASK="${TASK:-GenMech-InHandIsaacLab-step0-reference-v0}"
export NUM_ENVS="${NUM_ENVS:-8192}"
export MAX_EPOCHS="${MAX_EPOCHS:-5000}"
export SEED="${SEED:-42}"
export OMNI_KIT_ACCEPT_EULA=YES

mkdir -p "$REPO/debug_outputs/train_logs/inhand_isaaclab"
cd "$REPO"

echo "[isaaclab_ref] task $TASK"
echo "[isaaclab_ref] envs $NUM_ENVS  epochs $MAX_EPOCHS  seed $SEED"

exec .venv_isaacsim/bin/python -u -m isaacsimenvs.inhand_isaaclab.train \
    --task "$TASK" --num-envs "$NUM_ENVS" --max-epochs "$MAX_EPOCHS" --seed "$SEED" --wandb
