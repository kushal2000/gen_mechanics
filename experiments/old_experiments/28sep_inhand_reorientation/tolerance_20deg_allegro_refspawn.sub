#!/bin/bash
#SBATCH --job-name=allegro_tol20_refspawn
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --signal=B:USR1@900
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/28sep_inhand_reorientation/allegro_tol20_refspawn-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/28sep_inhand_reorientation/allegro_tol20_refspawn-%j.err

# ALLEGRO AT A 20 DEGREE SUCCESS THRESHOLD -- the first commercial hand.
#
# Same task as tolerance_20deg.sub; the hand is what differs. This is the real Wonik
# Allegro URDF, 16 DoF, with its real meshes, limits and vendor gains -- not a hand
# from our design grammar and not a capsule approximation of one.
#
# The spec is a REGISTERED fixed hand, allegro_handonly, which declares
# arm_joint_names=() itself. So it takes no "handonly:" prefix -- that prefix exists to
# make a generated POPULATION hand-only, and is_population_ref would reject a registry
# name carrying it. common.sh accepts the *_handonly naming convention instead.
#
# What to expect, and why the numbers are not comparable to SHARPA's run epoch for
# epoch: 16 joints against 22, so a narrower action space and a different observation
# width, and a policy trained from scratch rather than continued. The comparable
# quantity is what the hand achieves, not how fast it gets there.
#
#   sbatch tolerance_20deg_allegro.sub
#
# THE FIX-SIDE TEST OF THE PLACEMENT HYPOTHESIS. Identical to tolerance_20deg_allegro.sub
# (585759) -- our env, our reward, our keypoint metric, our Allegro, our SAPG + transformer --
# except where the cube starts.
#
# Measured in palm_link's frame with the same probe in both envs:
#   IsaacLab reference  cube centre (102, 9, 57) mm  -- over the fingertip centroid, on the pads
#   ours (585759)       cube centre (65, -14, 85) mm -- over the palm, ~60 mm above the tips
# This run uses the new "palm_body_offset" placement to put our cube at the reference's
# (102, 9) with its lowest point 25 mm above palm_link; verified by probe at (102.1, 9.0),
# and a do-nothing hand keeps it 98.8% of the time for 10 s.
#
# Paired with isaaclab_rung_ourspawn.sub, which moves THEIR cube to OUR placement. Reading
# both: if theirs breaks and ours is fixed, placement is the answer from both directions.
export USER_HYDRA="env.reset.in_hand_placement=palm_body_offset env.reset.in_hand_palm_offset=[0.102,0.009,0.025] env.reset.in_hand_drop_margin=0.0"
set -euo pipefail

# gen-SHARPA -- SHARPA rebuilt inside the design grammar. handonly: is what drops
# the 7 arm joints, and common.sh refuses a bare reference: the prefix has to be
# on the spec string because the agent YAML interpolates the network's shape from
# env.assets.robot_spec, so a separate flag would build a 37-joint policy against
# a 30-joint robot.
export ROBOT_SPEC="${ROBOT_SPEC:-allegro_handonly}"
export STUDY_ID="${STUDY_ID:-inhand_allegro_tol20_refspawn_refspawn}"
export SUCCESS_TOLERANCE_DEG=20
export EPOCHS="${EPOCHS:-15000}" MAX_CONT="${MAX_CONT:-10}" CONT="${CONT:-1}"

source /share/portal/kk837/gen_mechanics/experiments/old_experiments/28sep_inhand_reorientation/common.sh
run_and_chain "$0"
