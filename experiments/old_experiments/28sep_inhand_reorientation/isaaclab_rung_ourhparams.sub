#!/bin/bash
#SBATCH --job-name=isaaclab_ourhparams
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ourhparams-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ourhparams-%j.err
#
# DELTA: OUR PPO hyperparameters (lr 1e-4, 2 mini_epochs, horizon 16, entropy 0, reward_shaper
# 0.01, bounds 1e-4, minibatch half the rollout) with their PPO otherwise. The SAPG rung kept
# THEIR lr 5e-4 / 5 mini_epochs / horizon 24, so this part of our learner was never tested.
#
# ONE DELTA FROM THE REFERENCE, everything else theirs -- env, network and PPO. Read
# against isaaclab_reference.sub (590311), which at 8192 envs took episode length from
# 19 to 550 by epoch 142 and reached 0.207 goals/episode by epoch 1054. The comparison is
# at MATCHED EPOCHS, not matched wall-clock.
#
# The header of isaaclab_reference.sub carries the shared reasoning; this file only says
# what is different. See the rung's docstring in isaacsimenvs/inhand_isaaclab/env_cfg.py.
#
#   sbatch isaaclab_rung_ourhparams.sub
set -euo pipefail
REPO=/share/portal/kk837/gen_mechanics
export OMNI_KIT_ACCEPT_EULA=YES
mkdir -p "$REPO/debug_outputs/train_logs/inhand_isaaclab"
cd "$REPO"
echo "[isaaclab_ourhparams] task GenMech-InHandIsaacLab-step0-reference-v0  extra: "
exec .venv_isaacsim/bin/python -u -m isaacsimenvs.inhand_isaaclab.train \
    --task "GenMech-InHandIsaacLab-step0-reference-v0" --num-envs "${NUM_ENVS:-8192}" --max-epochs "${MAX_EPOCHS:-5000}" \
    --seed "${SEED:-42}" --our-hparams --wandb
