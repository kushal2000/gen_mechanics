#!/bin/bash
#SBATCH --job-name=STUDY_beam
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64000
#SBATCH --time=2:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/05nov_noevolution/%x-%A_%a.log
# Study 5's evaluations (study_beam.py submits these): line <task id> of $JOBS
# (manifest, envs per hand, output, seed, checkpoint, training run, table clearance) through eval_values.py.
set -euo pipefail
cd /share/portal/kk837/gen_mechanics
read -r MAN ENVS OUT SEED CKPT RUN TC < <(sed -n "$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))p" "$JOBS")
[ -f "$OUT" ] && { echo "exists: $OUT"; exit 0; }
exec .venv_isaacsim/bin/python -u experiments/05nov_noevolution/studies/eval_values.py --manifest "$MAN" \
    --checkpoint "$CKPT" --train-run "$RUN" --out "$OUT" --envs-per-hand "$ENVS" --seed "$SEED" --table-clearance "$TC"
