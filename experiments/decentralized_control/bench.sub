#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --get-user-env
#SBATCH --mem=50000
#SBATCH -t 0-01:00:00           # benchmarks are short; do not hold a GPU for days
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

# One benchmark job, on its own GPU. Two of these sharing a card inflates every
# number, which is the whole reason to use slurm for them rather than a login
# shell. Output lands in debug_outputs/bench_logs/$BENCH_TAG/.
#
# MODE=net    run profile_net.py (pure torch, no simulator, fast)
#     BENCH_TAG=arch     MODE=net ARGS="arch"              sbatch .../bench.sub
#     BENCH_TAG=speed    MODE=net ARGS="speedups --d_model 64" sbatch .../bench.sub
#     BENCH_TAG=sanity   MODE=net ARGS="sanity"            sbatch .../bench.sub
#     BENCH_TAG=sweep    MODE=net ARGS="sweep --axis all"  sbatch .../bench.sub
#
# MODE=env    run profile_env.py (boots Isaac Sim, several minutes)
#     BENCH_TAG=envstep  MODE=env ARGS="step"              sbatch .../bench.sub
#     BENCH_TAG=obscheck MODE=env ARGS="obs --num_envs 1024 --num_assets_per_type 2" sbatch .../bench.sub
#
# MODE=train  end-to-end fps on the real loop. One knob per job so a matrix can
#             be fanned out and read back as a table. Knobs below.
#     BENCH_TAG=tp_l1_d64  MODE=train D_MODEL=64 COMPILE_NET=true sbatch .../bench.sub
#     BENCH_TAG=tp_mlp     MODE=train ARCH=mlp                    sbatch .../bench.sub
#     BENCH_TAG=attrib     MODE=train PROFILE_UPDATE=1 MAX_EPOCHS=14 sbatch .../bench.sub

set -uo pipefail

REPO_ROOT="/share/portal/kk837/gen_mechanics"
BENCH_TAG="${BENCH_TAG:?set BENCH_TAG}"
MODE="${MODE:-train}"
ARGS="${ARGS:-}"

RUN_DIR="${REPO_ROOT}/debug_outputs/bench_logs/${BENCH_TAG}"
rm -rf "$RUN_DIR"; mkdir -p "$RUN_DIR"
[ -n "${SLURM_JOB_ID:-}" ] && scontrol update JobId="$SLURM_JOB_ID" JobName="bench_${BENCH_TAG}" || true
exec > "${RUN_DIR}/out.log" 2>&1

cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export OMNI_KIT_ACCEPT_EULA=YES
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache"
export TORCHINDUCTOR_CACHE_DIR="/tmp/${USER}_inductor_cache"
mkdir -p "$OMNI_KIT_CACHE_PATH" "$TORCHINDUCTOR_CACHE_DIR"

nvidia-smi --query-gpu=name,memory.total,power.limit --format=csv,noheader
read -r -a SCRIPT_ARGS <<< "$ARGS"

if [ "$MODE" = "net" ]; then
  echo "bench=$BENCH_TAG mode=net args=$ARGS"
  python -u experiments/decentralized_control/profile_net.py \
      ${SCRIPT_ARGS[@]+"${SCRIPT_ARGS[@]}"}
  exit $?
fi

if [ "$MODE" = "env" ]; then
  echo "bench=$BENCH_TAG mode=env args=$ARGS"
  python -u experiments/decentralized_control/profile_env.py \
      ${SCRIPT_ARGS[@]+"${SCRIPT_ARGS[@]}"}
  exit $?
fi

# ---------------------------------------------------------------- MODE=train
ARCH="${ARCH:-transformer}"                # transformer | mlp
ACTOR_LAYERS="${ACTOR_LAYERS:-1}"
CRITIC_LAYERS="${CRITIC_LAYERS:-$ACTOR_LAYERS}"
D_MODEL="${D_MODEL:-64}"
N_HEADS="${N_HEADS:-4}"
COMPILE_NET="${COMPILE_NET:-false}"
COMPILE_MODE="${COMPILE_MODE:-}"
MINIBATCH_SIZE="${MINIBATCH_SIZE:-16384}"
ARM_MA="${ARM_MA:-1.0}"
HAND_MA="${HAND_MA:-1.0}"
NUM_ENVS="${NUM_ENVS:-24576}"
NUM_ASSETS_PER_TYPE="${NUM_ASSETS_PER_TYPE:-100}"
MAX_EPOCHS="${MAX_EPOCHS:-45}"
PROFILE_UPDATE="${PROFILE_UPDATE:-0}"
SEED="${SEED:-0}"

case "$ARCH" in
  transformer) AGENT="rl_games_joint_transformer_cfg_entry_point" ;;
  mlp)         AGENT="rl_games_sapg_nolstm_cfg_entry_point" ;;
  *) echo "ARCH must be transformer or mlp" >&2; exit 1 ;;
esac

echo "bench=$BENCH_TAG mode=train arch=$ARCH actor_L=$ACTOR_LAYERS critic_L=$CRITIC_LAYERS d_model=$D_MODEL heads=$N_HEADS compile=$COMPILE_NET/${COMPILE_MODE:-default} minibatch=$MINIBATCH_SIZE arm_ma=$ARM_MA envs=$NUM_ENVS epochs=$MAX_EPOCHS profile_update=$PROFILE_UPDATE"

# A throughput number always comes with the occupancy and clock that produced
# it: identical env configs have differed by 22% in fps step across nodes.
( while true; do nvidia-smi --query-gpu=memory.used,utilization.gpu,clocks.sm \
    --format=csv,noheader,nounits; sleep 10; done > "${RUN_DIR}/mem.csv" ) &
MONPID=$!
trap 'kill $MONPID 2>/dev/null' EXIT

ARCH_ARGS=()
if [ "$ARCH" = "transformer" ]; then
  # The asymmetric critic inherits NOTHING from the actor's network block.
  ARCH_ARGS=(
    agent.params.network.n_layers="$ACTOR_LAYERS"
    agent.params.network.d_model="$D_MODEL"
    agent.params.network.n_heads="$N_HEADS"
    agent.params.network.compile_net="$COMPILE_NET"
    agent.params.network.compile_mode="$COMPILE_MODE"
    agent.params.config.central_value_config.network.n_layers="$CRITIC_LAYERS"
    agent.params.config.central_value_config.network.d_model="$D_MODEL"
    agent.params.config.central_value_config.network.n_heads="$N_HEADS"
    agent.params.config.central_value_config.network.compile_net="$COMPILE_NET"
    agent.params.config.central_value_config.network.compile_mode="$COMPILE_MODE"
  )
fi

ENTRY=(python -u coevolution/train.py)
[ "$PROFILE_UPDATE" = "1" ] && ENTRY=(python -u experiments/decentralized_control/profile_env.py update --)

"${ENTRY[@]}" \
    --task GenMech-PoseReach-Direct-v0 \
    --agent "$AGENT" \
    --headless \
    env.assets.robot_spec=sharpa_iiwa14 \
    env.assets.robot_population_path="" \
    env.assets.robot_population_seed=-1 \
    env.assets.robot_population_count=0 \
    env.assets.num_assets_per_type="$NUM_ASSETS_PER_TYPE" \
    env.scene.num_envs="$NUM_ENVS" \
    env.action.arm_moving_average="$ARM_MA" \
    env.action.hand_moving_average="$HAND_MA" \
    env.domain_randomization.use_obs_delay=false \
    env.domain_randomization.use_action_delay=false \
    env.domain_randomization.use_object_state_delay_noise=false \
    env.domain_randomization.joint_velocity_obs_noise_std=0.0 \
    env.domain_randomization.force_scale=0.0 \
    env.domain_randomization.torque_scale=0.0 \
    agent.params.seed="$SEED" \
    agent.params.config.minibatch_size="$MINIBATCH_SIZE" \
    agent.params.config.central_value_config.minibatch_size="$MINIBATCH_SIZE" \
    agent.params.config.expl_coef_block_size=4096 \
    agent.params.config.max_epochs="$MAX_EPOCHS" \
    "${ARCH_ARGS[@]}" \
    hydra.run.dir="$RUN_DIR"
STATUS=$?

# Steady state only: skip the first 20 epochs (allocator growth, torch.compile).
{
  echo
  echo "=== BENCH SUMMARY $BENCH_TAG (exit=$STATUS) ==="
  for KEY in "fps step  " "fps step + policy inference" "fps total"; do
    grep -a "$KEY" "${RUN_DIR}/out.log" | tail -n +20 | sed 's/,//g' \
      | awk -v k="$KEY" '{s+=$NF;n++} END{if(n)printf "  %-30s %9.0f  (n=%d)\n",k,s/n,n}'
  done
  for KEY in "Play time" "Update time"; do
    grep -a "$KEY" "${RUN_DIR}/out.log" | tail -n +20 \
      | awk -v k="$KEY" '{s+=$(NF-1);n++} END{if(n)printf "  %-30s %9.3f s\n",k,s/n}'
  done
  awk -F, 'BEGIN{m=0} $1>m{m=$1} END{printf "  %-30s %9d MiB\n","peak gpu mem",m}' \
    "${RUN_DIR}/mem.csv" 2>/dev/null
} >> "${RUN_DIR}/out.log"
