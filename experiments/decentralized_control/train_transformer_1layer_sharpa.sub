#!/bin/bash
# One-layer wrapper around the validated transformer launcher.  Keeping the
# implementation in one place ensures the 1-layer and 4-layer runs have the
# same SHARPA, DR, logging, and SAPG settings.
#
#   sbatch experiments/decentralized_control/train_transformer_1layer_sharpa.sub

#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --get-user-env
#SBATCH --mem=50000
#SBATCH -t 3-00:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

set -euo pipefail
export TRANSFORMER_LAYERS=1
# Slurm executes a spooled copy of this wrapper, so dirname "$0" is not the
# repository directory on compute nodes. Keep the target path explicit.
exec /share/portal/kk837/gen_mechanics/experiments/decentralized_control/train_joint_transformer_sharpa.sub
