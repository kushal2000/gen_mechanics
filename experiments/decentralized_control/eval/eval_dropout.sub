#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --get-user-env
#SBATCH --mem=50000
#SBATCH -t 0-04:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

# ONE finger-dropout variant per job, so the six run on six GPUs at once.
# Each writes its own JSON; collect_dropout.py merges them into the table.
#
#   CKPT=debug_outputs/train_logs/<run>/0_pose_reach_jt_sapg/nn/<x>.pth
#   for V in intact thumb index middle ring pinky; do
#     VARIANT=$V CHECKPOINT=$CKPT sbatch experiments/decentralized_control/eval/eval_dropout.sub
#   done
#   python experiments/decentralized_control/eval/collect_dropout.py
#
# Each job re-boots Isaac and re-converts its URDF (~2-4 min) and then runs
# 4096 envs x 6000 steps. Running them in one process would serialise six
# boots as well as six rollouts.

set -uo pipefail

REPO_ROOT="/share/portal/kk837/gen_mechanics"
VARIANT="${VARIANT:?set VARIANT (intact|thumb|index|middle|ring|pinky)}"
CHECKPOINT="${CHECKPOINT:?set CHECKPOINT to a .pth trained on the intact hand}"
NUM_ENVS="${NUM_ENVS:-4096}"
STEPS="${STEPS:-6000}"
NUM_ASSETS_PER_TYPE="${NUM_ASSETS_PER_TYPE:-100}"
SEED="${SEED:-0}"
SAPG_EXPL_COEF="${SAPG_EXPL_COEF:-50.0}"
TAG="${TAG:-dropout}"
# 1 keeps the robot's visual meshes so it can be rendered. Off by default:
# stripping them is what makes 24k-env scene composition affordable, and it
# leaves the robot invisible to any camera.
KEEP_VISUALS="${KEEP_VISUALS:-0}"

OUT_DIR="${REPO_ROOT}/debug_outputs/eval_logs/${TAG}"
mkdir -p "$OUT_DIR"
[ -n "${SLURM_JOB_ID:-}" ] && scontrol update JobId="$SLURM_JOB_ID" JobName="eval_${TAG}_${VARIANT}" || true
exec > "${OUT_DIR}/${VARIANT}.log" 2>&1

cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export GENMECH_KEEP_VISUALS="$KEEP_VISUALS"
export OMNI_KIT_ACCEPT_EULA=YES
# Per-variant Kit cache: six jobs converting six different URDFs into one
# shared cache directory is a race, and a corrupted cache fails minutes into
# a boot with an error that does not name the cause.
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache_${VARIANT}"
export TORCHINDUCTOR_CACHE_DIR="/tmp/${USER}_inductor_cache"
mkdir -p "$OMNI_KIT_CACHE_PATH" "$TORCHINDUCTOR_CACHE_DIR"

echo "variant=$VARIANT envs=$NUM_ENVS steps=$STEPS assets=$NUM_ASSETS_PER_TYPE seed=$SEED coef=$SAPG_EXPL_COEF"
echo "checkpoint=$CHECKPOINT"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

python -u experiments/decentralized_control/eval/eval_finger_dropout.py \
    --checkpoint "$CHECKPOINT" \
    --variants "$VARIANT" \
    --num_envs "$NUM_ENVS" \
    --steps "$STEPS" \
    --num_assets_per_type "$NUM_ASSETS_PER_TYPE" \
    --seed "$SEED" \
    --sapg_expl_coef "$SAPG_EXPL_COEF" \
    --out "${OUT_DIR}/${VARIANT}.json"
echo "exit=$?"
