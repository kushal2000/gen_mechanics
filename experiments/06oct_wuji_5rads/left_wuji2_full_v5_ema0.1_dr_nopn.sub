# LEFT wuji2 full: in-hand reorientation, Wuji v2 'full', uniform dynamics with every hand joint capped at 5 rad/s, hand-target moving average 0.1, obs/action delay and object-state delay on, no object pose noise, canonical palm frame + palm_extents, 5000 epochs. Generated by 06oct_wuji_5rads/make_runs.py.
export ARCH=transformer
export OBS_LIST="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents]"
export USER_HYDRA="agent.params.config.gamma=0.998 env.assets.robot_friction=0.5 env.assets.finger_tip_friction=0.5 env.assets.object_friction=0.5 env.obs.canonical_palm_frame=true env.action.hand_moving_average=0.1 env.domain_randomization.use_obs_delay=true env.domain_randomization.use_action_delay=true env.domain_randomization.use_object_state_delay_noise=true env.domain_randomization.object_state_xyz_noise_std=0.0 env.domain_randomization.object_state_rotation_noise_degrees=0.0"
export LEARNING_RATE=0.0005 MINI_EPOCHS=5 LR_SCHEDULE=adaptive HORIZON=16
export D_MODEL=64 TRANSFORMER_LAYERS=4 N_HEADS=1 FF_MULT=2
export MU_HEAD_UNITS="[64]" VALUE_HEAD_UNITS="[512,256]"
export GRAD_CHECKPOINT=false MASK_GHOST_ACTIONS=false
export HAND_VELOCITY_LIMIT=5.0
set -euo pipefail
export ROBOT_SPEC="${ROBOT_SPEC:-wuji2_left_uniform_handonly}"
export STUDY_ID="${STUDY_ID:-left_wuji2_full_v5_ema0.1_dr_nopn}"
export SUCCESS_TOLERANCE_DEG=5
export EPOCHS="${EPOCHS:-5000}" MAX_CONT="${MAX_CONT:-1}" CONT="${CONT:-1}"
export WANDB_PROJECT="${WANDB_PROJECT:-gen_mechanics_minimal_embodiment}"
export SCALING_RUN_ROOT="${SCALING_RUN_ROOT:-/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/06oct_wuji_5rads}"

source /share/portal/kk837/gen_mechanics/experiments/old_experiments/28sep_inhand_reorientation/common.sh
run_and_chain "$0"
