#!/bin/bash
#SBATCH --job-name=pushsweep
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64000
#SBATCH --time=06:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
# Push-robustness sweep of ONE policy on HAND: AXIS=scale varies force_scale at push prob $SCALE_PROB/step
# (default 0.03); AXIS=prob varies the per-step push probability at force_scale 50. 1024 envs x $EVAL_SECONDS s
# (default 240) per point, episodes capped at $MAX_GOALS goals (default 50, as in training) so the result
# carries goals_per_episode_first, the training metric.
#   sbatch --export=ALL,HAND=wuji2,TARGET=wuji2,CKPT=<pth>,LABEL=<name>,AXIS=scale run_push_sweep.sub
set -uo pipefail
REPO=/share/portal/kk837/gen_mechanics
MAX_GOALS=${MAX_GOALS:-50}; SECONDS_PER=${EVAL_SECONDS:-240}; SCALE_PROB=${SCALE_PROB:-0.03}
OUT=$REPO/experiments/02oct_ood_evals/results/push_sweep_cap${MAX_GOALS}/$LABEL
LOGS=$REPO/debug_outputs/embodiment_niches_push_sweep/logs_cap${MAX_GOALS}/$LABEL
mkdir -p $OUT $LOGS
cd $REPO
export OMNI_KIT_ACCEPT_EULA=YES
if [ "$AXIS" = scale ]; then VALUES="0 10 20 35 50 75 100 150"; else VALUES="0.005 0.01 0.02 0.03 0.05 0.1 0.2"; fi
for v in $VALUES; do
    if [ "$AXIS" = scale ]; then s=$v; p=$SCALE_PROB; else s=50; p=$v; fi
    f=$OUT/${AXIS}_${v}.json
    [ -s "$f" ] && { echo "skip $f"; continue; }
    .venv_isaacsim/bin/python experiments/01oct_embodiment_niches/eval_niches.py --set uniform --hand "$HAND" \
        ${TARGET:+--target "$TARGET"} --checkpoint "$CKPT" --condition nominal --num-envs 1024 --seconds $SECONDS_PER --max-goals $MAX_GOALS \
        --override "domain_randomization.force_scale=${s}.0" \
        --override "domain_randomization.force_prob_range=($p, $p)" \
        --out "$f" > $LOGS/${AXIS}_${v}.log 2>&1 || echo "FAILED $LABEL $AXIS $v"
    grep -h "\[niches\]" $LOGS/${AXIS}_${v}.log
done
