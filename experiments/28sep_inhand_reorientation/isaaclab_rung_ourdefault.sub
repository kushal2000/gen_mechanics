#!/bin/bash
#SBATCH --job-name=isaaclab_ourdefault
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ourdefault-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_ourdefault-%j.err
#
# THEIR ENV MOVED ALL THE WAY TO OUR DEFAULT (control 585759), except observation and network.
# See InHandIsaacLabOurDefaultCfg for the full delta list. Verified by probe against our env:
# 5.00 deg palm, spawn (65.0,-13.8,84.8) mm, our reset pose (tips at 97.3,-20.1,1.3), 98.0% held
# by a do-nothing hand, our frictions / masses / drives. Learner: SAPG 6x2048, gamma 0.99, our
# PPO hparams, mixed precision, 12288 envs.
#
# ONE DELTA FROM THE REFERENCE, everything else theirs -- env, network and PPO. Read
# against isaaclab_reference.sub (590311), which at 8192 envs took episode length from
# 19 to 550 by epoch 142 and reached 0.207 goals/episode by epoch 1054. The comparison is
# at MATCHED EPOCHS, not matched wall-clock.
#
# The header of isaaclab_reference.sub carries the shared reasoning; this file only says
# what is different. See the rung's docstring in isaacsimenvs/inhand_isaaclab/env_cfg.py.
#
#   sbatch isaaclab_rung_ourdefault.sub
set -euo pipefail
REPO=/share/portal/kk837/gen_mechanics
export OMNI_KIT_ACCEPT_EULA=YES
mkdir -p "$REPO/debug_outputs/train_logs/inhand_isaaclab"
cd "$REPO"
echo "[isaaclab_ourdefault] task GenMech-InHandIsaacLab-ourdefault-v0  extra: "
exec .venv_isaacsim/bin/python -u -m isaacsimenvs.inhand_isaaclab.train \
    --task "GenMech-InHandIsaacLab-ourdefault-v0" --num-envs "${NUM_ENVS:-12288}" --max-epochs "${MAX_EPOCHS:-5000}" \
    --seed "${SEED:-42}" --sapg --sapg-block-size 2048 --gamma 0.99 --our-hparams --mixed-precision --wandb
