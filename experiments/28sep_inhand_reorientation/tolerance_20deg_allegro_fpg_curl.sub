#!/bin/bash
#SBATCH --job-name=allegro_fpg_curl
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --signal=B:USR1@900
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/28sep_inhand_reorientation/allegro_fpg_curl-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/28sep_inhand_reorientation/allegro_fpg_curl-%j.err

# ALLEGRO AT A 20 DEGREE SUCCESS THRESHOLD -- the first commercial hand.
#
# Same task as tolerance_20deg.sub; the hand is what differs. This is the real Wonik
# Allegro URDF, 16 DoF, with its real meshes, limits and vendor gains -- not a hand
# from our design grammar and not a capsule approximation of one.
#
# The spec is a REGISTERED fixed hand, allegro_handonly, which declares
# arm_joint_names=() itself. So it takes no "handonly:" prefix -- that prefix exists to
# make a generated POPULATION hand-only, and is_population_ref would reject a registry
# name carrying it. common.sh accepts the *_handonly naming convention instead.
#
# What to expect, and why the numbers are not comparable to SHARPA's run epoch for
# epoch: 16 joints against 22, so a narrower action space and a different observation
# width, and a policy trained from scratch rather than continued. The comparable
# quantity is what the hand achieves, not how fast it gets there.
#
#   sbatch tolerance_20deg_allegro.sub
#
# REORIENTATION TEST on the fixed base: THEIR curled-finger reset. Their reset samples U[0.2 lo + d, 0.2 hi + d]
# (mean d + 0.1(lo+hi)); ours lerps 10% toward U(lo, hi). Lerping 20% instead gives the same mean offset.
# Probe: with their reset our hand's fingertip centroid sits 10.9 mm above the palm vs 1.4 mm with ours.
# One delta from the base.
export USER_HYDRA="env.reward.fall_penalty=200.0 agent.params.config.gamma=0.998 env.reset.reset_dof_pos_random_interval_fingers=0.2"
set -euo pipefail

# gen-SHARPA -- SHARPA rebuilt inside the design grammar. handonly: is what drops
# the 7 arm joints, and common.sh refuses a bare reference: the prefix has to be
# on the spec string because the agent YAML interpolates the network's shape from
# env.assets.robot_spec, so a separate flag would build a 37-joint policy against
# a 30-joint robot.
export ROBOT_SPEC="${ROBOT_SPEC:-allegro_handonly}"
export STUDY_ID="${STUDY_ID:-inhand_allegro_fpg_curl}"
export SUCCESS_TOLERANCE_DEG=20
export EPOCHS="${EPOCHS:-15000}" MAX_CONT="${MAX_CONT:-10}" CONT="${CONT:-1}"

source /share/portal/kk837/gen_mechanics/experiments/28sep_inhand_reorientation/common.sh
run_and_chain "$0"
