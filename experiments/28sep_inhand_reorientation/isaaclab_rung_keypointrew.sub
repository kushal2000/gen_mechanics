#!/bin/bash
#SBATCH --job-name=isaaclab_keypointrew
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_keypointrew-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/inhand_isaaclab/isaaclab_keypointrew-%j.err
#
# DELTA: OUR REWARD on their env -- progress against a record, measured on OUR keypoint
# residual instead of their quaternion angle. Paired with isaaclab_rung_progressrew.sub,
# which has the same progress shape on the true angle, so the two separate shape from metric.
# Identical weight (267) and record-keeping; the residual is divided by the keypoint radius
# so its small-angle scale equals theta. Success/termination stay on their angle.
# progressrew slowed possession ~15x but kept climbing (400 at epoch 451). If this arm
# stalls or collapses the way our env does, the keypoint metric is the missing piece.
#
# ONE DELTA FROM THE REFERENCE, everything else theirs -- env, network and PPO. Read
# against isaaclab_reference.sub (590311), which at 8192 envs took episode length from
# 19 to 550 by epoch 142 and reached 0.207 goals/episode by epoch 1054. The comparison is
# at MATCHED EPOCHS, not matched wall-clock.
#
# The header of isaaclab_reference.sub carries the shared reasoning; this file only says
# what is different. See the rung's docstring in isaacsimenvs/inhand_isaaclab/env_cfg.py.
#
#   sbatch isaaclab_rung_keypointrew.sub
set -euo pipefail
REPO=/share/portal/kk837/gen_mechanics
export OMNI_KIT_ACCEPT_EULA=YES
mkdir -p "$REPO/debug_outputs/train_logs/inhand_isaaclab"
cd "$REPO"
echo "[isaaclab_keypointrew] task GenMech-InHandIsaacLab-keypointrew-v0  extra: "
exec .venv_isaacsim/bin/python -u -m isaacsimenvs.inhand_isaaclab.train \
    --task "GenMech-InHandIsaacLab-keypointrew-v0" --num-envs "${NUM_ENVS:-8192}" --max-epochs "${MAX_EPOCHS:-5000}" \
    --seed "${SEED:-42}"  --wandb
