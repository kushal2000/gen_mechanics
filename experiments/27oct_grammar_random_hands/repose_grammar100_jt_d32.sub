#!/bin/bash
#SBATCH --job-name=GR_grammar100_jt_d32
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/27oct_grammar_random_hands/%x-%j.log
# Pen repose v2, ONE policy across all 100 random grammar hands (multi-embodiment): every hand in
# assets/urdf/27oct_grammar_random_hands/manifest.json in one scene, envs dealt round-robin (245-246 per hand at
# 24576), the joint-token TRANSFORMER over 22 padded joint slots. Same task settings as the single-hand runs; its own
# wandb project.
#   network   width (d_model) 32, else OlympicsJointTransformerSAPG.yaml's (4 layers, 1 head, ff x4), torch.compile'd
#   learner   minibatch 114688 (= the MLP's; the SAPG-augmented 458752 rows / 4), 2 mini-epochs, lr 1e-4 adaptive:
#             8 updates per epoch. Measured on hand 000 alone at 24576 envs (no compile): 33.8 GB peak of 48, 5.2 s/epoch.
#   tokens    "extent" link boxes + joint_origin (the 27 Oct joint tokens; 22 values per token)
#   sbatch experiments/27oct_grammar_random_hands/repose_grammar100_jt_d32.sub
set -euo pipefail
cd /share/portal/kk837/gen_mechanics
export HAND=multi:assets/urdf/27oct_grammar_random_hands/manifest.json
export HAND_TAG=grammar100
export TASKS=pen_repose
export PEN_SHAPE=box
export ARCH=transformer
export NUM_ENVS=24576 EPOCHS=5000 SEED=100 GAMMA=0.99
export FINGER_RESET=1.0 KEYPOINT=best_so_far
export EXTRA_HYDRA="env.goal.first_goal_tolerance=0.03 env.pen_repose.random_first_goal=True env.pen_repose.goal_sampling=uniform env.action.wrist_max_speed_ang=0.0 env.obs.joint_box=extent agent.params.network.d_model=32 agent.params.network.compile_net=true agent.params.config.minibatch_size=114688 agent.params.config.mini_epochs=2 agent.params.config.learning_rate=1e-4"
export RUN_TAG=uni_fw_ext_d32
export LOG_GROUP=27oct_grammar_random_hands
export WANDB_PROJECT=gen_mechanics_pen_repose_grammar100 WANDB=1
exec bash experiments/12oct_inhand_olympics/olympics_sapg_mlp.sub
