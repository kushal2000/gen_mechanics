#!/bin/bash
#SBATCH --job-name=L_shadow_v10
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --signal=B:USR1@900
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/30sep_ten_hands/left_shadow_v10-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/30sep_ten_hands/left_shadow_v10-%j.err

# LEFT shadow: in-hand reorientation, default configuration, 5000 epochs. Generated by make_runs.py.
export ARCH=transformer
export OBS_LIST="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel]"
export USER_HYDRA="agent.params.config.gamma=0.998"
export LEARNING_RATE=0.0005 MINI_EPOCHS=5 LR_SCHEDULE=adaptive HORIZON=16
export D_MODEL=64 TRANSFORMER_LAYERS=4 N_HEADS=1 FF_MULT=2
export MU_HEAD_UNITS="[64]" VALUE_HEAD_UNITS="[512,256]"
export GRAD_CHECKPOINT=false MASK_GHOST_ACTIONS=false
export HAND_VELOCITY_LIMIT=10.0
set -euo pipefail
export ROBOT_SPEC="${ROBOT_SPEC:-shadow_left_handonly}"
export STUDY_ID="${STUDY_ID:-left_shadow_v10}"
export SUCCESS_TOLERANCE_DEG=5
export EPOCHS="${EPOCHS:-5000}" MAX_CONT="${MAX_CONT:-1}" CONT="${CONT:-1}"
export WANDB_PROJECT="${WANDB_PROJECT:-gen_mechanics_ten_hands}"
export SCALING_RUN_ROOT="${SCALING_RUN_ROOT:-/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/30sep_ten_hands}"

source /share/portal/kk837/gen_mechanics/experiments/28sep_inhand_reorientation/common.sh
run_and_chain "$0"
