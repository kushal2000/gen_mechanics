#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/30oct_evolution_evaluation/log_std_cap/%x-%j.log
# Log-std cap validation, failure case (31 Oct, the user's call; README.md here): the RL-only control resumed from the
# same epoch-30800 checkpoint as ../../29oct_evolution_from_scratch/long_rl_only_ext4.sub (its log-std reaches 9.6 on joint
# slots 24, 35-38), identical except ++agent.params.network.max_log_std=2.0, for 1,000 epochs. Compare with ext4 (uncapped,
# running): info/amp_skip_frac, floor hits, the KL tail (mean vs median), goals.
#   sbatch experiments/oct_2026_experiments/30oct_evolution_evaluation/log_std_cap/rl_only_cap.sub
set -euo pipefail
cd /share/portal/kk837/gen_mechanics
export HAND="multi:template:assets/urdf/29oct_niche_seed/manifest.json" HAND_TAG=evo RUN_TAG=rl_only_cap LOG_GROUP=30oct_evolution_evaluation/log_std_cap
export EPOCHS=31800 CHECKPOINT=debug_outputs/train_logs/29oct_evolution_from_scratch/long_runs/0_pen_repose_sapg_transformer_e24576_s100_g0.99_fr1.0_kpbest_so_far_box_evo_rl_only_long_ext_851838/0_pen_repose_sapg_transformer_e24576_s100_g0.99_fr1.0_kpbest_so_far_box_evo_rl_only_long_ext_851838/last/model.pth.old CHECKPOINT_MODE=resume WANDB_NAME=rl_only_cap WANDB_GROUP=log_std_cap
export TASKS=pen_repose PEN_SHAPE=box ARCH=transformer NUM_ENVS=24576 SEED=100 GAMMA=0.99 FINGER_RESET=1.0 \
    KEYPOINT=best_so_far WANDB=1 WANDB_PROJECT=gen_mechanics_evolution_scratch VIEWER_INTERVAL=1000000
OLD_OBS="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot]"
OLD_STATE="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot,object_keypoints_rel_joint,palm_keypoints,ee_pos,ee_rot,ee_vel,object_rot,fingertip_pos_rel_palm,closest_keypoint_max_dist,closest_fingertip_dist,progress,successes,reward]"
export EXTRA_HYDRA="env.goal.first_goal_tolerance=0.03 env.pen_repose.random_first_goal=True env.pen_repose.goal_sampling=uniform env.action.wrist_max_speed_ang=0.0 env.action.finger_target=home env.action.use_action_delay=False env.obs.obs_list=$OLD_OBS env.obs.state_list=$OLD_STATE agent.params.network.token_mode=finger agent.params.network.d_model=128 agent.params.network.n_layers=2 agent.params.network.n_heads=4 agent.params.network.ff_mult=4 agent.params.network.decoder_units=[256] agent.params.network.arm_head_units=[1024,512] agent.params.network.value_head_units=[512,256] agent.params.network.compile_net=true agent.params.network.affine_norm=false agent.params.network.packed_tokens=true agent.params.network.mask_ghost_actions=true ++agent.params.network.shared_log_std=false agent.params.network.masked_arm_dims=[3,4,5] agent.params.config.rollout_autocast=true agent.params.config.minibatch_size=16384 agent.params.config.mini_epochs=2 agent.params.config.learning_rate=1e-4 agent.params.config.lr_schedule=adaptive agent.params.config.save_frequency=636 ++agent.params.config.max_lr=1e-3 ++agent.params.config.min_loss_scale=1.0 ++agent.params.network.max_log_std=2.0"
exec bash experiments/oct_2026_experiments/12oct_inhand_olympics/olympics_sapg_mlp.sub
