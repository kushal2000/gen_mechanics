#!/bin/bash
#SBATCH --job-name=CAP_rl_only
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64000
#SBATCH --time=48:00:00
