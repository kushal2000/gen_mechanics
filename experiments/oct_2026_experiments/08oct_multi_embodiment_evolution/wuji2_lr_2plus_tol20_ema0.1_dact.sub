#!/bin/bash
#SBATCH --job-name=L_wuji2_lr_2plus_tol20_ema0.1_dact
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --signal=B:USR1@900
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/08oct_multi_embodiment_evolution/wuji2_lr_2plus_tol20_ema0.1_dact-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/08oct_multi_embodiment_evolution/wuji2_lr_2plus_tol20_ema0.1_dact-%j.err

# ONE policy over all 52 Wuji v2 embodiments with >= 2 fingers, left and right (multi:wuji2_lr_2plus), 5 rad/s, moving average 0.1, action delay, canonical palm frame + palm_extents, 20 deg success tolerance, 5000 epochs per link. Generated by 08oct_multi_embodiment_evolution/make_runs.py.
export ARCH=transformer
export OBS_LIST="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents]"
export USER_HYDRA="agent.params.config.gamma=0.998 env.assets.robot_friction=0.5 env.assets.finger_tip_friction=0.5 env.assets.object_friction=0.5 env.obs.canonical_palm_frame=true env.action.hand_moving_average=0.1 env.domain_randomization.use_action_delay=true"
export LEARNING_RATE=0.0005 MINI_EPOCHS=5 LR_SCHEDULE=adaptive HORIZON=16
export D_MODEL=64 TRANSFORMER_LAYERS=4 N_HEADS=1 FF_MULT=2
export MU_HEAD_UNITS="[64]" VALUE_HEAD_UNITS="[512,256]"
export GRAD_CHECKPOINT=false MASK_GHOST_ACTIONS=false
export HAND_VELOCITY_LIMIT=5.0
export CAPTURE_VIEWER_INTERVAL="${CAPTURE_VIEWER_INTERVAL:-10000}"
set -euo pipefail
export ROBOT_SPEC="${ROBOT_SPEC:-multi:wuji2_lr_2plus}"
export STUDY_ID="${STUDY_ID:-wuji2_lr_2plus_tol20_ema0.1_dact}"
export SUCCESS_TOLERANCE_DEG=20
export EPOCHS="${EPOCHS:-5000}" MAX_CONT="${MAX_CONT:-1}" CONT="${CONT:-1}"
export WANDB_PROJECT="${WANDB_PROJECT:-gen_mechanics_wuji2_multi_embodiment}"
export SCALING_RUN_ROOT="${SCALING_RUN_ROOT:-/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/08oct_multi_embodiment_evolution}"

source /share/portal/kk837/gen_mechanics/experiments/_shared/common.sh
run_and_chain "$0"
