#!/bin/bash
#SBATCH --job-name=L_leap_uniform_canon
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --signal=B:USR1@900
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/01oct_uniform_dynamics/left_leap_uniform_canon-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/01oct_uniform_dynamics/left_leap_uniform_canon-%j.err

# LEFT leap: in-hand reorientation, UNIFORM dynamics, default configuration, canonical palm frame + palm_extents, 5000 epochs. Generated by 01oct_uniform_dynamics/make_runs.py.
export ARCH=transformer
export OBS_LIST="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents]"
export USER_HYDRA="agent.params.config.gamma=0.998 env.assets.robot_friction=0.5 env.assets.finger_tip_friction=0.5 env.assets.object_friction=0.5 env.obs.canonical_palm_frame=true"
export LEARNING_RATE=0.0005 MINI_EPOCHS=5 LR_SCHEDULE=adaptive HORIZON=16
export D_MODEL=64 TRANSFORMER_LAYERS=4 N_HEADS=1 FF_MULT=2
export MU_HEAD_UNITS="[64]" VALUE_HEAD_UNITS="[512,256]"
export GRAD_CHECKPOINT=false MASK_GHOST_ACTIONS=false
set -euo pipefail
export ROBOT_SPEC="${ROBOT_SPEC:-leap_left_uniform_handonly}"
export STUDY_ID="${STUDY_ID:-left_leap_uniform_canon}"
export SUCCESS_TOLERANCE_DEG=5
export EPOCHS="${EPOCHS:-5000}" MAX_CONT="${MAX_CONT:-1}" CONT="${CONT:-1}"
export WANDB_PROJECT="${WANDB_PROJECT:-gen_mechanics_uniform_dynamics}"
export SCALING_RUN_ROOT="${SCALING_RUN_ROOT:-/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/01oct_uniform_dynamics}"

source /share/portal/kk837/gen_mechanics/experiments/28sep_inhand_reorientation/common.sh
run_and_chain "$0"
