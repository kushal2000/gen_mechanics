#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=8
#SBATCH --get-user-env
#SBATCH --mem=96000
#SBATCH -t 3-00:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

# SHARPA on the iiwa14. The reference run -- copy this file for variants.
#   sbatch experiments/train_single_embodiment_sharpa.sub
#   SEED=1 MAX_EPOCHS=20000 sbatch experiments/train_single_embodiment_sharpa.sub

set -euo pipefail

ROBOT="${ROBOT:-sharpa_iiwa14}"
SEED="${SEED:-0}"
NUM_ENVS="${NUM_ENVS:-24576}"
MAX_EPOCHS="${MAX_EPOCHS:-120000}"    # ends the run; SBATCH -t is only a ceiling
HORIZON_LENGTH=16                     # must match coevolution/cfg/train/PoseReachSAPG.yaml
EXPL_COEF_BLOCK_SIZE=4096
WANDB_PROJECT="${WANDB_PROJECT:-gen_mechanics}"
WANDB_GROUP="${WANDB_GROUP:-$ROBOT}"
WANDB_ENTITY="${WANDB_ENTITY:-kk837}"
REPO_ROOT="/share/portal/kk837/gen_mechanics"

# Scale the minibatch with NUM_ENVS: the YAML's value is sized for 24576, and a
# smaller run floors num_minibatches to 0 and dies inside rl_games init_tensors.
BATCH=$(( HORIZON_LENGTH * NUM_ENVS ))
MINIBATCH_SIZE="${MINIBATCH_SIZE:-$(( BATCH / 4 ))}"
(( NUM_ENVS % EXPL_COEF_BLOCK_SIZE == 0 )) || { echo "NUM_ENVS must be a multiple of $EXPL_COEF_BLOCK_SIZE" >&2; exit 1; }
(( BATCH % MINIBATCH_SIZE == 0 ))          || { echo "MINIBATCH_SIZE must divide $BATCH" >&2; exit 1; }

EXPERIMENT_NAME="${ROBOT}_seed${SEED}_$(date +%Y-%m-%d_%H-%M-%S)"
[ -n "${SLURM_JOB_ID:-}" ] && scontrol update JobId="$SLURM_JOB_ID" JobName="$EXPERIMENT_NAME" || true
RUN_DIR="${REPO_ROOT}/train_dir/${WANDB_PROJECT}/${WANDB_GROUP}/${EXPERIMENT_NAME}"
mkdir -p "$RUN_DIR"
exec > "${RUN_DIR}/slurm.log" 2> "${RUN_DIR}/slurm.err"   # SBATCH -o/-e are /dev/null

cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export OMNI_KIT_ACCEPT_EULA=YES
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache"        # local disk, never NFS
mkdir -p "$OMNI_KIT_CACHE_PATH"

echo "robot=$ROBOT seed=$SEED epochs=$MAX_EPOCHS envs=$NUM_ENVS minibatch=$MINIBATCH_SIZE"
nvidia-smi --query-gpu=name --format=csv,noheader

python -u coevolution/train.py \
    --task GenMech-PoseReach-Direct-v0 \
    --agent rl_games_sapg_cfg_entry_point \
    --headless \
    --wandb_activate \
    --wandb_project "$WANDB_PROJECT" \
    --wandb_group "$WANDB_GROUP" \
    --wandb_entity "$WANDB_ENTITY" \
    --wandb_name "$EXPERIMENT_NAME" \
    --wandb_tags "$ROBOT" "seed$SEED" \
    env.assets.robot_spec="$ROBOT" \
    env.scene.num_envs="$NUM_ENVS" \
    agent.params.seed="$SEED" \
    agent.params.config.max_epochs="$MAX_EPOCHS" \
    agent.params.config.minibatch_size="$MINIBATCH_SIZE" \
    agent.params.config.central_value_config.minibatch_size="$MINIBATCH_SIZE" \
    agent.params.config.expl_coef_block_size="$EXPL_COEF_BLOCK_SIZE" \
    hydra.run.dir="$RUN_DIR"
