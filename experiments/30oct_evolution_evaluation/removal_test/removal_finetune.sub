#!/bin/bash
#SBATCH --job-name=RM_finetune
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64000
#SBATCH --time=4:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29oct_evolution_from_scratch/%x-%j.log
# The finger-removal test (30 Oct, the user's call; README.md): MAP-Elites' gen_0021 policy fine-tuned for one iteration's
# training (636 epochs, weights only, optimizer fresh as in every evolution iteration) on its 3-finger elites and their
# single-finger removals together (build_removals.py), then every hand scored with the evolution fitness (20 envs per
# hand). Every setting as experiments/29oct_evolution_from_scratch/map_elites.sub.
#   sbatch experiments/30oct_evolution_evaluation/removal_test/removal_finetune.sub
set -euo pipefail
cd /share/portal/kk837/gen_mechanics
O=debug_outputs/evolution/removal_test
export HAND="multi:template:$O/manifest.json" HAND_TAG=evo RUN_TAG=removal_ft LOG_GROUP=30oct_evolution_evaluation/removal_test
export EPOCHS=636 CHECKPOINT=debug_outputs/evolution/map_elites/gen_0021/policy.pth CHECKPOINT_MODE=weights WANDB_NAME=removal_finetune WANDB_GROUP=eval
export TASKS=pen_repose PEN_SHAPE=box ARCH=transformer NUM_ENVS=24576 SEED=100 GAMMA=0.99 FINGER_RESET=1.0 \
    KEYPOINT=best_so_far WANDB=1 WANDB_PROJECT=gen_mechanics_evolution_scratch VIEWER_INTERVAL=1000000
OLD_OBS="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot]"
OLD_STATE="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_link_bbox,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot,object_keypoints_rel_joint,palm_keypoints,ee_pos,ee_rot,ee_vel,object_rot,fingertip_pos_rel_palm,closest_keypoint_max_dist,closest_fingertip_dist,progress,successes,reward]"
export EXTRA_HYDRA="env.goal.first_goal_tolerance=0.03 env.pen_repose.random_first_goal=True env.pen_repose.goal_sampling=uniform env.action.wrist_max_speed_ang=0.0 env.action.finger_target=home env.action.use_action_delay=False env.obs.obs_list=$OLD_OBS env.obs.state_list=$OLD_STATE agent.params.network.token_mode=finger agent.params.network.d_model=128 agent.params.network.n_layers=2 agent.params.network.n_heads=4 agent.params.network.ff_mult=4 agent.params.network.decoder_units=[256] agent.params.network.arm_head_units=[1024,512] agent.params.network.value_head_units=[512,256] agent.params.network.compile_net=true agent.params.network.affine_norm=false agent.params.network.packed_tokens=true agent.params.network.mask_ghost_actions=true agent.params.network.masked_arm_dims=[3,4,5] agent.params.config.rollout_autocast=true agent.params.config.minibatch_size=16384 agent.params.config.mini_epochs=2 agent.params.config.learning_rate=1e-4 agent.params.config.lr_schedule=adaptive"
rm -rf debug_outputs/train_logs/$LOG_GROUP
bash experiments/12oct_inhand_olympics/olympics_sapg_mlp.sub > $O/finetune_train.log 2>&1 || true
grep -q "MAX EPOCHS" $O/finetune_train.log || { echo "[removal] training did not finish; see $O/finetune_train.log"; tail -20 $O/finetune_train.log; exit 1; }
TR=$(ls -d debug_outputs/train_logs/$LOG_GROUP/*/ | head -1)
CK=$(ls -t $TR*/nn/last_*_ep_*.pth | head -1)
.venv_isaacsim/bin/python coevolution/eval/eval_hands.py --manifest $O/manifest.json --checkpoint "$CK" --train-run "$TR" \
    --out $O/fitness_finetuned.json --envs-per-hand 20 > $O/fitness_finetuned.log 2>&1 || true
[[ -s $O/fitness_finetuned.json ]] || { echo "[removal] eval wrote nothing"; tail -20 $O/fitness_finetuned.log; exit 1; }
echo "[removal] done: $O/fitness_finetuned.json"
