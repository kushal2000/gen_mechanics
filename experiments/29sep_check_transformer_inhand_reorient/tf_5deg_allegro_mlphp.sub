#!/bin/bash
#SBATCH --job-name=tf5m_allegro
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128000
#SBATCH --time=24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --signal=B:USR1@900
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29sep_check_transformer_inhand_reorient/tf_5deg_allegro_mlphp-%j.log
#SBATCH --error=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29sep_check_transformer_inhand_reorient/tf_5deg_allegro_mlphp-%j.err

# JOINT TRANSFORMER POLICY, 5 DEG GOAL TOLERANCE, ON THE REAL WONIK ALLEGRO HAND (16 DoF, real URDF).
#
# The EXACT transformer counterpart of experiments/29sep_check_mlp_inhand_reorient/mlp_5deg_<hand>.sub:
# the same learner as the MLP runs (gamma 0.998, lr 5e-4 adaptive, 5 mini_epochs), so the pair differs
# ONLY in the network. Sibling of tf_5deg_<hand>.sub, which uses the original SAPG learner instead.
# No hand-global skip. Same wandb project, own log folder.
# One of three identical runs that differ only in ROBOT_SPEC (see README.md).
#
#   sbatch experiments/29sep_check_transformer_inhand_reorient/tf_5deg_allegro_mlphp.sub
export USER_HYDRA="env.reward.fall_penalty=200.0 agent.params.config.gamma=0.998"
export ARCH=transformer   # d_model 64, 4 layers (common.sh defaults)
export LEARNING_RATE=0.0005
export MINI_EPOCHS=5
set -euo pipefail

export ROBOT_SPEC="${ROBOT_SPEC:-allegro_handonly}"
export STUDY_ID="${STUDY_ID:-tf_5deg_allegro_mlphp_fixed}"
export SUCCESS_TOLERANCE_DEG=5
export EPOCHS="${EPOCHS:-15000}" MAX_CONT="${MAX_CONT:-10}" CONT="${CONT:-1}"
export WANDB_PROJECT="${WANDB_PROJECT:-gen_mechanics_check_mlp_inhand_reorient}"
export SCALING_RUN_ROOT="${SCALING_RUN_ROOT:-/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/29sep_check_transformer_inhand_reorient}"

source /share/portal/kk837/gen_mechanics/experiments/28sep_inhand_reorientation/common.sh
run_and_chain "$0"
