#!/bin/bash
#SBATCH --job-name=WUJI_rl
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=96000
#SBATCH --time=12:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH --output=/share/portal/kk837/gen_mechanics/debug_outputs/train_logs/coevolve/%x-%j.log
# RL on the unchanged vendor Wuji v2 (wuji2_left_uniform_handonly) for pen repose, wrist translation only, with the
# campaign's env / net / learner (coevolve.sub) -- multi:finger: (the vendor mesh colliders cannot go on the template;
# the same 6 x 5 token grid, so v1 checkpoints load) and the table-safe reset off (it indexes template links only).
#   sbatch --job-name=WUJI_rl_<name> --export=ALL,NAME=<name>[,CKPT=<policy.pth>] experiments/06nov_coevolve_v2/wuji_rl.sub
set -euo pipefail
cd /share/portal/kk837/gen_mechanics
OBS="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_origin,joint_axis,joint_link_vec,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot]"
STATE="[joint_pos,joint_vel,prev_joint_pos,prev_joint_vel,prev_action_targets,joint_origin,joint_axis,joint_link_vec,joint_lower,joint_upper,joint_enabled,keypoints_rel_ee,keypoints_rel_goal,object_vel,palm_extents,task_onehot,object_keypoints_rel_joint,palm_keypoints,ee_pos,ee_rot,ee_vel,object_rot,fingertip_pos_rel_palm,closest_keypoint_max_dist,closest_fingertip_dist,progress,successes,reward]"
ENV="env.goal.first_goal_tolerance=0.03 env.pen_repose.random_first_goal=True env.pen_repose.goal_sampling=uniform env.action.wrist_max_speed_ang=0.0 env.action.finger_target=home env.action.use_action_delay=False env.reset.table_safe=False env.obs.obs_list=$OBS env.obs.state_list=$STATE env.log.group_stats=False env.log.design_stats=True"
NET="agent.params.network.token_mode=finger agent.params.network.d_model=128 agent.params.network.n_layers=2 agent.params.network.n_heads=4 agent.params.network.ff_mult=4 agent.params.network.decoder_units=[256] agent.params.network.arm_head_units=[1024,512] agent.params.network.value_head_units=[512,256] agent.params.network.compile_net=true agent.params.network.affine_norm=false agent.params.network.packed_tokens=true agent.params.network.mask_ghost_actions=true agent.params.network.masked_arm_dims=[3,4,5]"
LEARN="agent.params.config.rollout_autocast=true agent.params.config.minibatch_size=16384 agent.params.config.mini_epochs=2"
LOG_GROUP="coevolve/wuji_rl/$NAME"
CK_VARS=()
[ -n "${CKPT:-}" ] && CK_VARS=(CHECKPOINT="$CKPT" CHECKPOINT_MODE=weights)
echo "[wuji_rl] $NAME on $(hostname); checkpoint ${CKPT:-none}"
env TASKS=pen_repose PEN_SHAPE=box ARCH=transformer NUM_ENVS=24576 SEED="${SEED:-100}" GAMMA=0.99 FINGER_RESET=1.0 \
    KEYPOINT=best_so_far HAND="multi:finger:wuji2_left_uniform_handonly" HAND_TAG=wuji2 RUN_TAG="wuji_$NAME" \
    LOG_GROUP="$LOG_GROUP" EPOCHS="${EPOCHS:-2604}" EXTRA_HYDRA="$ENV $NET $LEARN" \
    WANDB="${WANDB:-1}" WANDB_PROJECT="${WANDB_PROJECT:-v2_coevolve}" WANDB_NAME="wuji_$NAME" WANDB_GROUP="wuji_rl" \
    VIEWER_INTERVAL="${VIEWER_INTERVAL:-20000}" VIEWER_LEN=600 \
    ${CK_VARS[@]+"${CK_VARS[@]}"} \
    bash experiments/oct_2026_experiments/12oct_inhand_olympics/olympics_sapg_mlp.sub
